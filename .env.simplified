# ====================================
# STUDYSTREAM - SIMPLIFIED VERSION
# Environment Variables
# ====================================

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ====================================
# JWT Configuration
# ====================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ====================================
# Database Configuration (4 Databases)
# ====================================

# PostgreSQL - Auth Service
AUTH_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/auth_db

# PostgreSQL - User Service
USER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/user_db

# PostgreSQL - Task Service
TASK_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/task_db

# PostgreSQL - Notification Service
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/notification_db

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ====================================
# Redis Configuration
# ====================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Cache TTL (seconds)
CACHE_TTL_USER_PROFILE=300
CACHE_TTL_TASK_LIST=60

# ====================================
# Service URLs (for inter-service REST communication)
# ====================================
AUTH_SERVICE_URL=http://auth_service:8001
USER_SERVICE_URL=http://user_service:8002
TASK_SERVICE_URL=http://task_service:8003
NOTIFICATION_SERVICE_URL=http://notification_service:8004

# ====================================
# Service Ports (for local development)
# ====================================
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
TASK_SERVICE_PORT=8003
NOTIFICATION_SERVICE_PORT=8004

# ====================================
# Email/Notification Configuration
# ====================================
# Set to true to send actual emails (requires SMTP config)
EMAIL_ENABLED=false

# SMTP Configuration (optional - emails are simulated by default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@studystream.com

# ====================================
# Security
# ====================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# ====================================
# Testing
# ====================================
TESTING=false
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/test_db

# ====================================
# REMOVED FROM SIMPLIFIED VERSION
# ====================================
# The following are NOT needed in the simplified version:
# - RABBITMQ_URL (no message broker)
# - KAFKA_BROKERS (no Kafka)
# - PROMETHEUS_ENABLED (simplified monitoring)
# - LLM_SERVICE_URL (only 4 services)
# - OPENAI_API_KEY (no LLM service)
# - GRPC_* (REST only)
