# ====================================
# STUDYSTREAM - ENVIRONMENT VARIABLES
# ====================================

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ====================================
# JWT Configuration
# ====================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ====================================
# Database Configuration
# ====================================

# PostgreSQL - Auth Service
AUTH_DATABASE_URL=postgresql://auth_user:auth_pass@postgres:5432/auth_db

# PostgreSQL - User Service
USER_DATABASE_URL=postgresql://user_user:user_pass@postgres:5432/user_db

# PostgreSQL - Task Service
TASK_DATABASE_URL=postgresql://task_user:task_pass@postgres:5432/task_db

# PostgreSQL - Notification Service
NOTIFICATION_DATABASE_URL=postgresql://notif_user:notif_pass@postgres:5432/notification_db

# PostgreSQL - LLM Service
LLM_DATABASE_URL=postgresql://llm_user:llm_pass@postgres:5432/llm_db

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ====================================
# Redis Configuration
# ====================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Cache TTL (seconds)
CACHE_TTL_USER_PROFILE=300
CACHE_TTL_TASK_LIST=60
CACHE_TTL_JWT_BLACKLIST=3600

# ====================================
# RabbitMQ Configuration
# ====================================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=studystream_exchange
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE_PREFIX=studystream

# Message retry settings
MESSAGE_MAX_RETRIES=3
MESSAGE_RETRY_DELAY=5

# ====================================
# Service URLs (for inter-service communication)
# ====================================
AUTH_SERVICE_URL=http://auth_service:8001
USER_SERVICE_URL=http://user_service:8002
TASK_SERVICE_URL=http://task_service:8003
NOTIFICATION_SERVICE_URL=http://notification_service:8004
LLM_SERVICE_URL=http://llm_service:8005

# ====================================
# API Gateway Configuration
# ====================================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=80

# ====================================
# Service Ports (for local development)
# ====================================
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
TASK_SERVICE_PORT=8003
NOTIFICATION_SERVICE_PORT=8004
LLM_SERVICE_PORT=8005

# ====================================
# LLM Configuration (Mock/Real)
# ====================================
LLM_PROVIDER=mock
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7

# ====================================
# Email/Notification Configuration
# ====================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@studystream.com

# ====================================
# Monitoring & Observability
# ====================================
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# ====================================
# Security
# ====================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=60

# ====================================
# Testing
# ====================================
TESTING=false
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/test_db
